#!/usr/bin/env bash
# Restarts the SPO-Pipeline systemd --user services after this repo is updated (git pull /
# git merge). Installed as a symlink at .git/hooks/post-merge by daemon-install.sh and
# dashboard-install.sh -- either install script re-creates the same symlink, so installing
# one service also arms the restart-on-update behaviour for the other if it's present.
#
# Which units get restarted, and why the test is not `is-enabled`.
#
# `is-enabled` answers "does this unit start at boot". That is not the question. The
# question is "is a process running this repo's code right now, and is it now stale". A
# systemd unit can be **active and disabled** at the same time -- started by hand, or by an
# install script, without ever being enabled -- and `spo-pipeline-daemon.service` was
# exactly that on 2026-09-03: `active=active enabled=disabled`. Every `git pull` printed
# nothing about it, looked like a deploy, and left the daemon running code from before the
# merge. It ran eight-hour-old code for a whole working day.
#
# So the test is `is-active OR is-enabled`:
#   - active  -> it is running this repo's code and that code just changed. Restart it.
#   - enabled -> it is meant to be running; `restart` starts it if it is not.
# `list-unit-files` still gates both, so a unit that was never installed is skipped in
# silence rather than producing an error on every pull.
#
# WHY THE SKIP NOW PRINTS. `is-active OR is-enabled` is the right question; being SILENT when the
# answer is no was not. A unit stopped on purpose is legitimately skipped -- nothing is executing
# stale code, and starting it here would deploy a service nobody asked for -- but the pull then
# printed a dashboard restart, said nothing at all about the daemon, and looked exactly like a
# deploy that had covered both. Worse, the daemon reached that state on EVERY deliberate stop
# rather than only on request: its SIGTERM handler exits 143, the unit declared no
# SuccessExitStatus, so `systemctl stop` left it `failed` (fixed in scripts/daemon-install.sh --
# re-run it). One line costs nothing and makes "not deployed" distinguishable from "deployed".
#
# WHY --no-block. `systemctl restart` waits for the stop to finish, and since the drain landed a
# stop can legitimately take up to config.js's drainTimeoutMs (45 min) while the cards already in
# flight run to completion. Without --no-block that wait lands on the maintainer's terminal in the
# middle of `git pull`. With it, the pull returns at once and the restart proceeds on its own: the
# old daemon claims nothing more, finishes what it has, and the new code takes over when it exits.
# The deploy becomes asynchronous, which is what a drain makes it whether this hook waits or not.
set -euo pipefail

for unit in spo-pipeline-daemon.service spo-pipeline-dashboard.service; do
  systemctl --user list-unit-files "$unit" >/dev/null 2>&1 || continue

  if systemctl --user is-active "$unit" >/dev/null 2>&1; then
    reason='running'
  elif systemctl --user is-enabled "$unit" >/dev/null 2>&1; then
    reason='enabled'
  else
    # Installed but neither running nor enabled: nothing is executing stale code, and
    # starting it here would deploy a service nobody asked for. Said out loud, because a
    # silent skip is indistinguishable from a restart that happened.
    echo "== post-merge: SKIPPING $unit (installed but neither active nor enabled -- nothing to redeploy)"
    continue
  fi

  echo "== post-merge: restarting $unit ($reason; repo updated)"
  # --no-block: a daemon stop drains in-flight cards and may take up to 45 min. See the header.
  systemctl --user restart --no-block "$unit" || echo "!! post-merge: failed to restart $unit" >&2
done
