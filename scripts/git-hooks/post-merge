#!/usr/bin/env bash
# post-merge -- THE DEPLOY. `git pull` in the deploy checkout fires this; nothing else deploys.
# A merge on GitHub deploys nothing, and neither does a pull in any other worktree.
#
# Installed as a symlink at .git/hooks/post-merge by daemon-install.sh and dashboard-install.sh.
#
# WHAT IT DOES NOW, AND WHAT IT NO LONGER DOES. It used to restart the units in place, against a
# checkout that was simultaneously the tree the service executed, the tree a human edited and the
# tree the pull had just mutated. Under the immutable-release layout (doc/deployment.md) it instead
# decides WHETHER to deploy and hands the whole job to scripts/release.sh, which builds
# ~/.spo-releases/<sha>, moves ~/.spo-current and drain-restarts. Everything this file used to know
# about `is-active` vs `is-enabled`, `deactivating`, `--no-block` and saying skips out loud lives
# there now -- one copy, exercised by both the hook and a hand-run deploy.
#
# The one decision left here is the one release.sh cannot make: WHICH tree is allowed to deploy.
# See the comment on SOURCE_REPO below -- it is the difference between a deploy and an agent
# worktree accidentally publishing its own branch.

set -euo pipefail

# GIT_* is exported to every hook. Strip it before anything below shells out to git or to
# release.sh, or those commands act on the hook's own GIT_DIR rather than on the directory they
# name -- see scripts/release.sh's own header and test/no-git-env-sweep.test.js for what that
# cost once.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES \
      GIT_COMMON_DIR GIT_PREFIX GIT_NAMESPACE GIT_CEILING_DIRECTORIES GIT_CONFIG GIT_CONFIG_GLOBAL

# ONE CHECKOUT DEPLOYS, AND IT IS NOT WHICHEVER ONE FIRED THE HOOK.
#
# git runs this hook with cwd at the top of the working tree that was updated -- ANY working tree.
# This repo routinely has a dozen worktrees under .claude/worktrees/, and `git merge --ff-only`
# inside one of them fires this hook exactly as a pull in the main checkout does. That was already
# untidy when the hook only restarted services; under the release layout it would be a live
# hazard, because cutting a release from an agent worktree would DEPLOY THAT WORKTREE'S BRANCH.
#
# So the deploy checkout is named, not inferred, and every other tree is skipped out loud.
HERE="$(pwd -P)"
SOURCE_REPO="$(cd "${SPO_SOURCE_REPO:-$HOME/SPO-Pipeline}" 2>/dev/null && pwd -P || echo "${SPO_SOURCE_REPO:-$HOME/SPO-Pipeline}")"
DEPLOY_BRANCH="${SPO_DEPLOY_BRANCH:-main}"

if [ "$HERE" != "$SOURCE_REPO" ]; then
  echo "== post-merge: $HERE is not the deploy checkout ($SOURCE_REPO) -- nothing deployed"
  exit 0
fi

branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
if [ "$branch" != "$DEPLOY_BRANCH" ]; then
  echo "== post-merge: $SOURCE_REPO is on '$branch', not '$DEPLOY_BRANCH' -- nothing deployed"
  exit 0
fi

RELEASE_SH="$SOURCE_REPO/scripts/release.sh"
if [ ! -x "$RELEASE_SH" ]; then
  echo "!! post-merge: $RELEASE_SH is missing or not executable -- nothing deployed" >&2
  exit 0
fi

# release.sh does the whole deploy: build the tree for the new HEAD, move ~/.spo-current, and
# drain-restart the units (skipping ones that are stopped, saying so, and treating `deactivating`
# as a restart already in flight). This hook's only job is deciding WHETHER to deploy.
echo "== post-merge: deploying $(git rev-parse --short HEAD) from $SOURCE_REPO"
exec "$RELEASE_SH"
