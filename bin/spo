#!/usr/bin/env node
'use strict';
// spo -- reads ONLY the journals under journal/<id>/ (never its own state).
//
//   spo status              queue depth, bench queue depth (~/.spo-bench/spool,running), account
//                            health + cooldowns, today's billable-weighted spend (with its own
//                            "not journalled at all" caveat -- see `spo tokens`'s footer for the
//                            fuller honesty rule this reuses), active/backoff/parked/abandoned/
//                            done counts, and per-task state + reason. A PARKED/ABANDONED row's
//                            third column is state.json's OWN `reason` (never the last journal
//                            event's name -- see action 5.4's own note in cmdStatus for why that
//                            used to print the unpark scan's retry noise instead), plus, for a
//                            PARKED row, the unpark scan's own consecutive-failure streak if it
//                            has one. A card in action 4.4's bounded auto-retry backoff gets its
//                            own BACKOFF bucket (attempt number + next-run time, read off its
//                            queue entry) instead of being silently double-counted as `active`.
//   spo task <id>           human-readable timeline from journal/<id>/journal.jsonl
//   spo parked              parked tasks + reasons
//   spo tokens               what the pipeline has spent, in TOKENS, read back from the
//                            journals' own `llm-call` token events (orchestrator/tokens.js --
//                            no second ledger): per task (state, calls, the four token counts,
//                            billable-weighted total, park reasons), then the aggregate,
//                            billable-weighted tokens per DONE card and parking rate -- the two
//                            numbers migration step 3 asks for. Billable-weighted = fresh input
//                            + cache-creation + output; cache-read is reported separately, never
//                            summed into it (near-free on this project's Claude Max quota plan,
//                            and it dominates raw counts by orders of magnitude). An efficiency
//                            metric, not a budget -- there is no dollar figure anywhere here.
//                            "n/a" in a token column means NOT REPORTED, never zero: journals
//                            written before token capture shipped (2026-08-31) carry no token
//                            fields at all, and a killed/E2BIG call journals
//                            `tokensSource: null` -- a footer names how many calls lacked them.
//   spo cost                 DEPRECATED alias for `spo tokens` (dollars were retired as the
//                            headline metric, 2026-08-31) -- prints a one-line notice, then the
//                            same table. Kept only because some docs/gates still say "watching
//                            spo cost".
//   spo resume <id>         PRINTS `claude --resume <sessionId>` for a task's recorded LLM
//                            steps, or for a bare session id, the same command directly. Never
//                            executes anything -- see doc/state-machine-spec.md § Observability.
//   spo dashboard            GENERATES a self-contained static HTML file from the same local
//                            surfaces (journals, queue, the account pool, ~/.spo-bench/,
//                            ~/.spo-reports) -- console/collect.js + console/render.js do the
//                            work; this command just wires them to disk. --out <path> (default:
//                            console/dashboard.html), --watch regenerates every 30s (Ctrl-C to
//                            stop) instead of running once. Prints the absolute output path.
//                            --serve [--port 8090] [--host <addr>] [--no-prod] runs a LIVE HTTP
//                            server instead (console/serve.js): the page polls /api/system (CPU/
//                            memory, 1s) and /api/data (services, accounts, daemon stats, bug
//                            reports, production version, tokens; 30s) with no full reload.
//                            --no-prod disables the outbound starpeace.zz.works/GitHub probe.
//   spo accounts             Lists every account discovered in the pool directory: name,
//                            enabled, cooldownUntil (if cooling), whether an oauth-token file
//                            is present, whether the account's CLAUDE_CONFIG_DIR holds any
//                            credentials file of its own. See orchestrator/accounts.js /
//                            doc/setup.md § Accounts.
//   spo account add <name>   Creates <accounts-dir>/<name>/ and prints the guided next steps.
//                            Never runs `claude` itself.
//   spo account enable/disable <name>
//                            Creates or removes the `disabled` marker file for that account.
//   spo account sync-settings
//                            Installs <repo>/.claude/settings.json as every pool account's
//                            user-tier settings.json. An account directory IS a
//                            CLAUDE_CONFIG_DIR, so the machine's ~/.claude/settings.json is
//                            never read by a pipeline step -- this is what gives every account
//                            the same permission floor whatever the step's cwd. Idempotent;
//                            --dry reports what would change and writes nothing. Run
//                            automatically by `spo account add` and at every --real daemon
//                            start. See doc/permissions.md.
//   spo ask <text…>          Intake, fast lane: joins remaining argv as the free-text request,
//                            drafts a card (DRAFT_CARD, Sonnet 5), sends it to review-card
//                            (Fable 5, the neutral judge), then files it on FILE/FILE_AMENDED or
//                            prints the reason and files nothing on DO_NOT_FILE. See
//                            orchestrator/intake.js and orchestrator/README.md § Intake.
//                            --dry prints the draft + review verdict and files nothing.
//                            --draft-file <path>  Intake, brainstorm lane: skips the DRAFT_CARD
//                            LLM call and reads an already-written draft JSON from <path>
//                            instead (the hand-off point for an interactive session that
//                            formalized its own card) -- still goes through review -> file.
//                            Combines with --dry. Ignores any positional text when given.
//   spo pull [--limit N]     Reads the product board's cheap pool read (`npm run board:claim`,
//                            never a claim, never a board write) and writes a local
//                            queue/<seq>-issue-<n>.json task file for each of the top N
//                            claimable candidates (default 5), skipping one already queued or
//                            journaled. See orchestrator/intake.js.
//   Human-first bug-report intake -- see orchestrator/README.md § Report intake for the full
//   design. No LLM ever looks at a report until a maintainer has read it RAW and replied
//   "confirm" on the issue -- three commands, one per stage:
//   spo intake [--limit N] [--reports-dir <dir>]
//                            Stage 1, MECHANICAL (zero LLM calls): renders each queued report
//                            (~/.spo-reports, or --reports-dir/SPO_REPORTS_DIR) via SPO-WebClient's
//                            `npm run report:card`, dedups it by anchorKey (a grep, not a
//                            judgement), files a RAW card labeled report:raw, moves it to the
//                            "Intake" board column, and posts confirm/discard instructions. See
//                            orchestrator/report-intake.js.
//   spo reports [--reports-dir <dir>]
//                            Lists what is waiting in <reports-dir>/pending/ for a maintainer's
//                            "confirm"/"discard" reply -- the intake analogue of `spo parked`.
//   spo triage [--limit N] [--file]
//                            Stage 3+: reproduces/routes/drafts every report already replied
//                            "confirm" to, via orchestrator/intake.js's triageBugReport, then the
//                            SAME reviewCard gate `spo ask` uses, then intake.amendCard (edits the
//                            raw card in place -- never files a second issue). A report that fails
//                            mechanically, or whose reproduction does not confirm it, is HELD
//                            (commented, never silently dropped) -- see orchestrator/README.md
//                            § Auto-triage. Defaults to --dry; pass --file to actually act.
//   spo triage --retry <issue> [--file]
//                            ACTION 3.4 -- the recovery path for a report stuck at HOLD
//                            (report-held / report-held-mechanical / report-held with outcome
//                            do-not-file). Appends a fresh report-confirmed event for the issue,
//                            which both makes it eligible for triage again AND resets its
//                            mechanical-failure budget to 0 in the same move (see
//                            orchestrator/auto-triage.js's retryHeldReport). Refuses an issue
//                            with no report-confirmed event on record at all (nothing to
//                            re-confirm), one that is already eligible (no held event to recover
//                            from), one that was already filed/dispositioned (report-triaged), or
//                            one whose report file is missing from pending/ -- each with its own
//                            message, exit 1. Accepts a `#`-prefixed issue. Defaults to --dry
//                            like every other `spo triage` invocation (exit 0, preview only,
//                            nothing appended or posted); --file is required to actually append
//                            the event and post the recovery comment. See orchestrator/README.md
//                            § Report intake.
//   spo recette [--scenario <name>] [--keep] [--dry] [--force]
//                            ACTION 2.9 -- the supervised live harness, and the standard live
//                            gate this project uses from chantier 3 on: drives ONE trivial
//                            synthetic `kind: "card"` task through the REAL pipeline
//                            (config.real=true) against a dedicated, distinctly-labelled GitHub
//                            issue in the product repo, under a wall-clock + LLM-step-count cap,
//                            asserts the scenario's declared checks against the produced
//                            journal, then cleans up unconditionally (worktree, branches, PR,
//                            issue, its own isolated journal dir under .recette/) -- never the
//                            live journal/queue. Refuses to run while a live daemon holds
//                            journal/daemon.lock, unless --force. --dry prints the plan (no
//                            issue, no worktree, no LLM call, no side effect at all) and exits.
//                            --keep skips cleanup, for debugging a run by hand. See
//                            orchestrator/recette.js and orchestrator/README.md § Recette.
//
// Flags (any command): --journal <dir> --queue <dir>  (default: <repo>/journal, <repo>/queue)
// Flags (accounts commands + dashboard + status): --accounts-dir <dir>  (default: the account
//   pool -- see orchestrator/config.js's claudeAccountsDir / the SPO_ACCOUNTS_DIR env var)
// Flags (status): --bench-dir <dir>  (default: orchestrator/config.js's spoBenchDir,
//   ~/.spo-bench -- dashboard's own bench path is separate, see cmdDashboard)
// Flags (ask): --dry  --draft-file <path>
// Flags (pull): --limit <n>  (default 5)
// Flags (intake): --limit <n>  (default 3)  --reports-dir <dir>
// Flags (reports): --reports-dir <dir>
// Flags (triage): --limit <n>  (default 3)  --file (actually act; default dry-run)
//   --retry <issue>  (action 3.4 -- switches to the single-issue recovery path; --limit is
//   ignored with --retry; accepts a `#`-prefixed issue; --file still required to act)
// Flags (recette): --scenario <name> (default trivial-doc-log)  --keep  --dry  --force
//   --recette-dir <dir> (default <repo>/.recette)  --cap-ms <n>  --cap-llm-steps <n>

const fs = require('fs');
const path = require('path');
const os = require('os');
const { collectAll } = require('../console/collect');
const { renderDashboard } = require('../console/render');
const accounts = require('../orchestrator/accounts');
const defaultConfig = require('../orchestrator/config');
const intake = require('../orchestrator/intake');
const autoTriage = require('../orchestrator/auto-triage');
const reportIntake = require('../orchestrator/report-intake');
const remoteReportPull = require('../orchestrator/remote-report-pull');
const { tokenReport, todaySpend, formatTokenCount } = require('../orchestrator/tokens');
const recette = require('../orchestrator/recette');

function parseArgs(argv) {
  const opts = {
    journal: null,
    queue: null,
    out: null,
    watch: false,
    serve: false,
    port: null,
    accountsDir: null,
    benchDir: null,
    dry: false,
    draftFile: null,
    limit: null,
    reportsDir: null,
    file: false,
    retry: null,
    noProd: false,
    host: null,
    scenario: null,
    keep: false,
    force: false,
    recetteDir: null,
    capMs: null,
    capLlmSteps: null,
    _: [],
  };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === '--journal') opts.journal = argv[++i];
    else if (a === '--queue') opts.queue = argv[++i];
    else if (a === '--out') opts.out = argv[++i];
    else if (a === '--watch') opts.watch = true;
    else if (a === '--serve') opts.serve = true;
    else if (a === '--port') opts.port = argv[++i];
    else if (a === '--accounts-dir') opts.accountsDir = argv[++i];
    else if (a === '--bench-dir') opts.benchDir = argv[++i];
    else if (a === '--dry') opts.dry = true;
    else if (a === '--draft-file') opts.draftFile = argv[++i];
    else if (a === '--limit') opts.limit = argv[++i];
    else if (a === '--reports-dir') opts.reportsDir = argv[++i];
    else if (a === '--file') opts.file = true;
    else if (a === '--retry') opts.retry = argv[++i];
    else if (a === '--no-prod') opts.noProd = true;
    else if (a === '--host') opts.host = argv[++i];
    else if (a === '--scenario') opts.scenario = argv[++i];
    else if (a === '--keep') opts.keep = true;
    else if (a === '--force') opts.force = true;
    else if (a === '--recette-dir') opts.recetteDir = argv[++i];
    else if (a === '--cap-ms') opts.capMs = Number(argv[++i]);
    else if (a === '--cap-llm-steps') opts.capLlmSteps = Number(argv[++i]);
    else opts._.push(a);
  }
  return opts;
}

function resolveDirs(opts) {
  const repoRoot = path.join(__dirname, '..');
  return {
    journalRoot: opts.journal || path.join(repoRoot, 'journal'),
    queueDir: opts.queue || path.join(repoRoot, 'queue'),
  };
}

function resolveAccountsDir(opts) {
  return opts.accountsDir || defaultConfig.claudeAccountsDir;
}

function resolveBenchDir(opts) {
  return opts.benchDir || defaultConfig.spoBenchDir;
}

function readJsonSafe(p, fallback) {
  try {
    return JSON.parse(fs.readFileSync(p, 'utf8'));
  } catch {
    return fallback;
  }
}

function listTaskDirs(journalRoot) {
  if (!fs.existsSync(journalRoot)) return [];
  return fs
    .readdirSync(journalRoot, { withFileTypes: true })
    .filter((d) => d.isDirectory())
    .map((d) => d.name)
    .sort();
}

function readJournalLines(taskDir) {
  const p = path.join(taskDir, 'journal.jsonl');
  if (!fs.existsSync(p)) return [];
  return fs
    .readFileSync(p, 'utf8')
    .split('\n')
    .filter(Boolean)
    .map((line) => {
      try {
        return JSON.parse(line);
      } catch {
        return null;
      }
    })
    .filter(Boolean);
}

// ---- action 5.4 helpers -------------------------------------------------------------------
//
// Four things measurement (not the plan) added to `spo status`, each with its own header
// comment at the call site below: (A) the reason column, which read the last JOURNAL EVENT's
// name instead of state.json's own `reason` -- 3 of 3 parked cards in the live corpus were
// misnamed by this the day it was measured (`unpark-scan-failed`, the scan's OWN retry noise,
// on every one). (B) a card in action 4.4's bounded auto-retry backoff, which was invisible AND
// double-counted (once in queue depth, once in `active`) because it deliberately never writes
// PARKED. (C) bench queue depth + account health/cooldowns, folded in from the readers `spo
// accounts`/the dashboard already use rather than re-derived. (D) today's spend, with the C4
// handoff's caveat re-measured and restated (`orchestrator/tokens.js`'s `todaySpend`). (F) the
// unpark scan's own failure streak -- it failed 238 consecutive times over 33 hours
// (2026-08-30T10:11:23Z .. 2026-08-31T19:52:07Z) with nothing anywhere saying so; the
// maintainer's entire retry/abandon channel was silently dead the whole time.

// countDirEntries(dir) -- a bare readdirSync().length, wrapped so a missing directory (a dev box
// with no bench at all, or a bench that has never spooled a job) counts as 0 rather than
// throwing. Item C is explicit that this must not crash on an absent `~/.spo-bench`.
function countDirEntries(dir) {
  try {
    if (!dir || !fs.existsSync(dir)) return 0;
    return fs.readdirSync(dir).length;
  } catch {
    return 0;
  }
}

// collectBenchQueueDepth(benchDir) -- ~/.spo-bench/spool (jobs waiting for a worker) and
// ~/.spo-bench/running (jobs a worker currently holds). Both were empty on this machine when
// measured (2026-09-01); this reads whatever is actually there, not a fixed shape, since neither
// directory's file-naming convention is documented anywhere in this repo to assert against.
function collectBenchQueueDepth(benchDir) {
  if (!benchDir) return { spool: 0, running: 0 };
  return {
    spool: countDirEntries(path.join(benchDir, 'spool')),
    running: countDirEntries(path.join(benchDir, 'running')),
  };
}

// collectAccountsStatus(accountsDir, now) -- the SAME two reads cmdAccounts uses
// (accounts.readRegistry + accounts.readState), not a second derivation of the pool's on-disk
// shape. `cooling` is false the moment `cooldownUntil` is in the past -- an EXPIRED cooldown
// (the live example in this action's own spec: `{"pool1":{"cooldownUntil":1788247210631,...}}`,
// which is already in the past relative to "today" 2026-09-01) must render as "not cooling", the
// same rule `spo accounts` and the dashboard's `collectAccounts` both already apply.
function collectAccountsStatus(accountsDir, now = Date.now()) {
  let registry;
  try {
    registry = accounts.readRegistry(accountsDir);
  } catch {
    return [];
  }
  if (registry.length === 0) return [];
  const state = accounts.readState(accountsDir);
  return registry.map((a) => {
    const entry = state[a.name];
    const cooldownUntil = entry && typeof entry.cooldownUntil === 'number' ? entry.cooldownUntil : null;
    const cooling = typeof cooldownUntil === 'number' && cooldownUntil > now;
    return { name: a.name, enabled: a.enabled, cooling, cooldownUntil: cooling ? cooldownUntil : null };
  });
}

// formatRemaining(ms) -- "2h13m" style, floor-rounded (never "2h13m45.2s" -- a maintainer
// glancing at this wants "how much longer", not sub-minute precision on a multi-hour cooldown).
function formatRemaining(ms) {
  // Under a minute renders as "<1m", never "0m": this formats the age of the most recent
  // retry-channel failure, and a failure five seconds old -- the single most alarming case --
  // otherwise printed as the single least alarming string.
  const safe = Math.max(0, ms);
  if (safe < 60000) return safe > 0 ? '<1m' : '0m';
  const totalMinutes = Math.round(safe / 60000);
  const h = Math.floor(totalMinutes / 60);
  const m = totalMinutes % 60;
  return h > 0 ? `${h}h${String(m).padStart(2, '0')}m` : `${m}m`;
}

// collectBackoffEntries(queueDir) -- id -> {transientRetries, notBefore, file} for every queue
// entry action 4.4's finalizePark wrote via park-loop.js's reEnqueueTask (recognized by carrying
// a `notBefore` field -- an ordinary freshly-pulled task never has one). Read from the QUEUE
// ENTRY itself, not the journal's own `transient-retry` event, because the queue entry is what
// actually governs when the daemon will pick this card back up (state-machine.js's
// isEligibleNow reads `notBefore` off the task, not off the journal) -- the two carry the same
// numbers today, but the queue entry is the one that is actually true if they ever drift.
function collectBackoffEntries(queueDir) {
  const map = new Map();
  if (!queueDir || !fs.existsSync(queueDir)) return map;
  let files;
  try {
    files = fs.readdirSync(queueDir).filter((f) => f.endsWith('.json'));
  } catch {
    return map;
  }
  for (const f of files) {
    const parsed = readJsonSafe(path.join(queueDir, f), null);
    if (!parsed || typeof parsed.notBefore !== 'string') continue;
    const id = parsed.id || f.replace(/\.json$/, '');
    map.set(id, {
      transientRetries: typeof parsed.transientRetries === 'number' ? parsed.transientRetries : null,
      notBefore: parsed.notBefore,
      file: f,
    });
  }
  return map;
}

// computeUnparkScanFailureStreak(lines) -- item F: how badly, and for how long, this card's retry
// channel has been failing. `firstFailedAt` is the EARLIEST ts in the streak (what "failing for N
// hours" is measured from); `lastFailedAt` is the most recent one.
//
// The rule is "count `unpark-scan-failed` back to the last event that is NEITHER a failure NOR an
// `unpark-scan-backoff-skip`", and each half was measured against the real outage rather than
// reasoned about:
//
//   * A backoff-skip does NOT break the streak. It is a CONSEQUENCE of the failures --
//     comment-scan.js backs a failing issue off and then journals the skips -- so treating it as
//     a recovery is exactly backwards. The real tail of journal/issue-213 is
//     `failed, skip, skip, skip, skip, skip, skip, skip, failed, skip x7, failed`. Breaking on a
//     skip reported that 33-hour, 238-failure outage as **"FAILING x1 since 19:52:07"** -- one
//     minute of trouble instead of a day and a half. The feature built to surface the outage
//     would not have surfaced the outage.
//   * There is nothing positive to reset against. A SUCCESSFUL unpark scan journals no event at
//     all (park-loop.js's unparkScan just `continue`s when the scan is ok and matches nothing),
//     so this cannot distinguish "still failing" from "failed, then recovered silently" -- which
//     is the live state right now: the scan recovered when the daemon restarted at 07:17Z today,
//     and the journals' tails are still the old failures. That is why the caller renders the AGE
//     of the last failure and says what it can and cannot mean, instead of claiming a card is
//     failing. Making a success legible is filed separately; do NOT close the gap by adding a
//     heartbeat event, one was deliberately removed (PR #444).
function computeUnparkScanFailureStreak(lines) {
  let count = 0;
  let firstFailedAt = null;
  let lastFailedAt = null;
  for (let i = lines.length - 1; i >= 0; i--) {
    const ev = lines[i];
    if (!ev) break;
    if (ev.event === 'unpark-scan-backoff-skip') continue; // part of the same outage, not a recovery
    if (ev.event !== 'unpark-scan-failed') break;
    count += 1;
    if (lastFailedAt === null) lastFailedAt = ev.ts || null;
    firstFailedAt = ev.ts || firstFailedAt;
  }
  return { count, firstFailedAt, lastFailedAt };
}

function cmdStatus(opts) {
  const { journalRoot, queueDir } = resolveDirs(opts);
  const accountsDir = resolveAccountsDir(opts);
  const benchDir = resolveBenchDir(opts);
  const now = Date.now();

  const queueDepth = fs.existsSync(queueDir) ? fs.readdirSync(queueDir).filter((f) => f.endsWith('.json')).length : 0;
  const backoffEntries = collectBackoffEntries(queueDir);

  console.log(`queue depth: ${queueDepth}`);

  // C: bench queue depth. Read-only, never a crash on an absent ~/.spo-bench (a dev box may
  // have none at all -- see collectBenchQueueDepth's own comment).
  const bench = collectBenchQueueDepth(benchDir);
  console.log(`bench: spool=${bench.spool}  running=${bench.running}`);

  // C: account health + cooldowns, folded in from the same reader `spo accounts` uses.
  const accountRows = collectAccountsStatus(accountsDir, now);
  if (accountRows.length === 0) {
    console.log(`accounts: (none registered in ${accountsDir})`);
  } else {
    for (const a of accountRows) {
      const cooldown = a.cooling ? `cooling, ${formatRemaining(a.cooldownUntil - now)} remaining` : 'none';
      console.log(`account ${a.name}  enabled=${a.enabled}  cooldown=${cooldown}`);
    }
  }

  // D: today's spend. Same billable-weighted definition and the same "n/a means not reported,
  // never zero" honesty rule as `spo tokens` -- see orchestrator/tokens.js's todaySpend and
  // cmdTokens's own footer for the fuller text this echoes.
  const spend = todaySpend(journalRoot, { now });
  if (spend.llmCallsWithTokens === 0) {
    console.log('today: n/a -- no token data reported for any call today');
  } else {
    console.log(
      `today: billable ${formatTokenCount(spend.billableTokens)} tokens over ${spend.llmCallsWithTokens} reported call(s)` +
        (spend.llmCallsWithoutTokens > 0 ? ` (${spend.llmCallsWithoutTokens} more call(s) today reported no token data)` : '')
    );
  }
  // The erratum this line exists to keep surfacing, not fix: intake/triage steps journal into
  // journal/daemon.jsonl, which -- re-measured 2026-09-01 -- carries ZERO `llm-call` events of
  // any kind. Their spend is not merely excluded from the figure above; it is not recorded
  // anywhere yet. Fixing that journalling gap is a different action's work.
  console.log('  (note: intake/triage steps are not journalled with token data at all -- this figure is short by an unknown amount)');

  const ids = listTaskDirs(journalRoot);
  let active = 0;
  let backoff = 0;
  let parked = 0;
  let abandoned = 0;
  let done = 0;
  const rows = [];
  for (const id of ids) {
    const dir = path.join(journalRoot, id);
    const state = readJsonSafe(path.join(dir, 'state.json'), {});
    const lines = readJournalLines(dir);
    const last = lines.length ? lines[lines.length - 1] : null;
    const cur = state.state || 'UNKNOWN';
    const backoffEntry = (cur !== 'DONE' && cur !== 'PARKED' && cur !== 'ABANDONED') ? backoffEntries.get(id) : null;

    // action 4.5 (unchanged): ABANDONED is terminal, same as DONE/PARKED -- it must NOT fall
    // into the `else active` bucket below, which is otherwise everything still moving through
    // the pipeline.
    if (cur === 'DONE') {
      done++;
      // A: terminal state, own reason column -- but DONE has nothing TO explain (success needs
      // no justification the way a park does), so this stays the literal word "done" rather than
      // state.json's `reason` (which FINISH never writes -- see state-machine.js's own
      // `snapshot()`; reading it here would print "unknown" on every single DONE row, which is a
      // regression, not a fix). Previously this line ALSO happened to read "done" -- but only by
      // coincidence, because "done" is also the name of FINISH's own journal event; that
      // coincidence is what let a PARKED row get away with printing the totally unrelated
      // `unpark-scan-failed` event name in the same column.
      rows.push(`${id}  DONE  done`);
    } else if (cur === 'PARKED') {
      parked++;
      // A: the fix itself -- state.json's OWN `reason` field, not the last journal event's name.
      // Reproduces the real issue-213/385/428 shape: their last event is `unpark-scan-failed`
      // (238 of them on issue-213 alone), which is the unpark SCAN's own retry noise, not why the
      // card parked in the first place.
      const reason = state.reason || 'unknown';
      // F: the scan's own failure streak, read off the SAME journal lines already loaded above.
      const streak = computeUnparkScanFailureStreak(lines);
      // "last failure Nh ago", not "FAILING": a successful scan journals nothing, so an old
      // streak in the journal's tail cannot tell a still-broken channel from one that recovered
      // silently -- and both of those are true of the corpus right now. The AGE is the number a
      // maintainer can act on either way: minutes old means it is broken now; a day old means
      // either it is still broken or nobody can tell, and both deserve a look.
      const ageMs = streak.lastFailedAt ? now - Date.parse(streak.lastFailedAt) : null;
      const age = Number.isFinite(ageMs) ? formatRemaining(ageMs) : '?';
      const scanStatus =
        streak.count > 0
          ? `${streak.count} failure(s), last ${age} ago (first ${streak.firstFailedAt})`
          : 'no failures recorded';
      rows.push(`${id}  PARKED  reason=${reason}  retry-channel: ${scanStatus}`);
    } else if (cur === 'ABANDONED') {
      abandoned++;
      // A: same fix as PARKED -- state.json's `reason` here is 'abandoned-by-maintainer'
      // (park-loop.js's unparkScan overwrites the original park reason on abandon), which is
      // itself the honest terminal fact for this row.
      rows.push(`${id}  ABANDONED  reason=${state.reason || 'unknown'}`);
    } else if (backoffEntry) {
      // B: a card in action 4.4's bounded auto-retry -- NOT active (it isn't running right now,
      // it's waiting out a backoff delay) and NOT parked (finalizePark deliberately never wrote
      // PARKED for it -- see its own header comment). Its own bucket, sourced from the queue
      // entry so the "when" is the number that actually governs the next pickup.
      backoff++;
      const attempt = backoffEntry.transientRetries === null ? '?' : backoffEntry.transientRetries;
      // A `notBefore` already in the PAST is not a backoff any more -- the entry is eligible and
      // is simply waiting for the next drain (state-machine.js's isEligibleNow would take it
      // now). Saying BACKOFF there would be wrong in the direction that matters: with the daemon
      // stopped, a queue full of long-past `notBefore` entries would read as "all backing off,
      // nothing to see" instead of "nothing is draining this queue".
      const dueAt = Date.parse(backoffEntry.notBefore);
      const due = Number.isFinite(dueAt) && dueAt <= now;
      rows.push(
        due
          ? `${id}  BACKOFF  attempt=${attempt}  due now (since ${backoffEntry.notBefore})`
          : `${id}  BACKOFF  attempt=${attempt}  next-run=${backoffEntry.notBefore}`
      );
    } else {
      active++;
      // A: a non-terminal task has no `reason` of its own -- only PARKED/ABANDONED ever write
      // one (state-machine.js's finalizePark), and DONE has nothing to explain. The last journal
      // event's name is still the most useful single fact about "what is this task doing right
      // now", so it stays here unchanged -- the bug this action fixes is PARKED/DONE reading the
      // event name where state.json's own reason belongs, not this row.
      rows.push(`${id}  ${cur}  ${last ? last.event : ''}`);
    }
  }

  console.log(`active: ${active}  backoff: ${backoff}  parked: ${parked}  abandoned: ${abandoned}  done: ${done}`);
  for (const r of rows) console.log(r);
}

function cmdTask(id, opts) {
  const { journalRoot } = resolveDirs(opts);
  const dir = path.join(journalRoot, id);
  const lines = readJournalLines(dir);
  if (lines.length === 0) {
    console.error(`no journal for task "${id}" under ${journalRoot}`);
    process.exitCode = 1;
    return;
  }
  for (const ev of lines) {
    const detail = { ...ev };
    delete detail.ts;
    delete detail.state;
    delete detail.event;
    const detailStr = Object.keys(detail).length ? ` ${JSON.stringify(detail)}` : '';
    console.log(`[${ev.ts}] ${String(ev.state).padEnd(12)} ${ev.event}${detailStr}`);
  }
}

// `spo tokens` -- the soak's read-out: per task, then the two numbers migration step 3 asks for
// (parking rate and billable-weighted tokens per merged card). Everything comes from
// orchestrator/tokens.js, i.e. from the journals' own `llm-call` token events -- there is no
// second ledger, and no dollar figure anywhere (maintainer decision, 2026-08-31: the pool is a
// Claude Max quota, never metered API billing, so a dollar figure never meant money spent).
//
// Billable-weighted = fresh input + cache-creation + output; cache-read is shown as its own
// column, never folded into "billable", since it is near-free on a quota plan and dominates raw
// counts by orders of magnitude (console/usage-scan.js's own header).
//
// Parked-task count and park-EVENT count are both printed because they answer different
// questions: card #247 parked 6 times and still reached DONE.
//
// "cache expiries" (per task and in aggregate) is orchestrator/tokens.js's advisory
// `likelyCacheExpiry` signal -- evidence a call's cached prefix had gone cold (the gap since the
// task's previous llm-call exceeded the platform's observed cache TTL, and the call's own
// cache-creation tokens dominated its cache-read tokens), never proof, and never something this
// command or the daemon acts on -- reporting only.
function cmdTokens(opts) {
  const { journalRoot } = resolveDirs(opts);
  const report = tokenReport(journalRoot);

  if (report.tasks.length === 0) {
    console.log(`no task journals under ${journalRoot}`);
    return;
  }

  const idWidth = Math.max(4, ...report.tasks.map((t) => t.id.length));
  console.log(
    `${'task'.padEnd(idWidth)}  ${'state'.padEnd(7)}  ${'calls'.padStart(5)}  ${'in'.padStart(7)}  ` +
      `${'cache-cr'.padStart(8)}  ${'cache-rd'.padStart(8)}  ${'out'.padStart(7)}  ${'billable'.padStart(8)}  ` +
      `${'exp'.padStart(3)}  parks`
  );
  for (const t of report.tasks) {
    // Cache expiries get their OWN column, never the parks column: nothing about a likely cache
    // expiry parks anything (it is advisory, see orchestrator/tokens.js), and rendering it under
    // a heading called "parks" reads as though it did.
    const expiries = t.likelyCacheExpiries.length ? `x${t.likelyCacheExpiries.length}` : '';
    const parksParts = [];
    if (t.parkReasons.length) parksParts.push(`${t.parkReasons.length} [${t.parkReasons.join(', ')}]`);
    // A task whose llm-calls reported NO token fields at all (every journal written before
    // token capture shipped; a run of killed/E2BIG calls) prints "n/a", never 0 -- a 0 there is
    // indistinguishable from "this task genuinely used no tokens", which would be a false
    // measurement rather than a missing one. orchestrator/tokens.js's llmCallsWithTokens (from
    // each event's own `tokensSource`) is what makes the two distinguishable.
    const cell = (n) => (t.llmCallsWithTokens === 0 ? 'n/a' : formatTokenCount(n));
    console.log(
      `${t.id.padEnd(idWidth)}  ${t.state.padEnd(7)}  ${String(t.llmCalls).padStart(5)}  ` +
        `${cell(t.freshInputTokens).padStart(7)}  ${cell(t.cacheCreationTokens).padStart(8)}  ` +
        `${cell(t.cacheReadTokens).padStart(8)}  ${cell(t.outputTokens).padStart(7)}  ` +
        `${cell(t.billableTokens).padStart(8)}  ${expiries.padStart(3)}  ${parksParts.join('  ')}`
    );
  }

  // action 5.4, item G: denominator now matches console/collect.js's collectDaemonStats, which
  // action 4.5 already made count ABANDONED as terminal (`stats.total = done + parked +
  // abandoned`) -- this half was never updated to agree. Measured live 2026-09-01: this line
  // printed "parking rate: 17% (3/18 terminal)" while the dashboard's own figure for the SAME
  // corpus was 19. The side that moved is this one, not collect.js: an abandon really is a
  // terminal outcome (the card is closed out), so it belongs in the denominator; it stays OUT of
  // the numerator (`report.parked` alone) because it is not a park still awaiting a maintainer's
  // reply -- see orchestrator/tokens.js's own comment on `abandoned` for the same reasoning.
  const finished = report.done + report.parked + report.abandoned;
  const anyTokens = report.llmCallsWithTokens > 0;
  console.log('');
  if (anyTokens) {
    console.log(
      `total: in ${formatTokenCount(report.freshInputTokens)}  cache-cr ${formatTokenCount(report.cacheCreationTokens)}  ` +
        `cache-rd ${formatTokenCount(report.cacheReadTokens)}  out ${formatTokenCount(report.outputTokens)}  ` +
        `billable ${formatTokenCount(report.billableTokens)}  over ${report.tasks.length} tasks`
    );
  } else {
    console.log(`total: n/a -- no token data in any journal, over ${report.tasks.length} tasks`);
  }
  console.log(`done: ${report.done}  parked: ${report.parked}  abandoned: ${report.abandoned}  park events: ${report.parks}`);
  if (report.billableTokensPerDoneCard !== null) {
    console.log(`billable tokens per DONE card: ${formatTokenCount(report.billableTokensPerDoneCard)}`);
  } else if (report.done > 0) {
    console.log('billable tokens per DONE card: n/a (no token data)');
  }
  if (finished > 0) {
    // The parking RATE the migration plan asks for: of the cards that reached a terminal
    // state, the share that ended parked rather than done.
    console.log(`parking rate: ${((report.parked / finished) * 100).toFixed(0)}% (${report.parked}/${finished} terminal)`);
  }
  console.log(`cache expiries (likely, advisory only): ${report.likelyCacheExpiries}`);

  // The footer that keeps this report honest. `llm-call` events written before token capture
  // shipped (2026-08-31) carry only the retired `costUsd` and no `tokensSource` at all, and a
  // killed/E2BIG call journals `tokensSource: null` -- both are "not reported", NOT zero. Say so
  // out loud rather than letting a table of 0s (or n/a) be read as "this pipeline used no
  // tokens".
  if (report.llmCallsWithoutTokens > 0) {
    console.log('');
    console.log(
      `note: ${report.llmCallsWithoutTokens} of ${report.llmCalls} llm-call events carry no token data ` +
        `(no \`tokensSource\`, or \`tokensSource: null\`) and are NOT counted above -- "n/a" means ` +
        'not reported, not zero. Journals written before token capture shipped (2026-08-31) recorded ' +
        'only the now-retired dollar figure; a deadline-killed or E2BIG call never gets a token block ' +
        'at all. Only calls made by the current build report tokens.'
    );
  }
}

// `spo cost` -- DEPRECATED alias for `spo tokens` (dollars retired as the headline metric,
// 2026-08-31 -- see orchestrator/tokens.js's own header for why). Kept because
// doc/remediation-plan-2026-08.md's Gate C3 (and possibly other docs) says "watching `spo
// cost`"; a hard removal would break a documented gate mid-plan. Prints one notice line, then
// runs the exact same table `spo tokens` does.
function cmdCostDeprecated(opts) {
  console.log('spo cost: deprecated -- dollars were retired as the headline metric (2026-08-31). Use `spo tokens`. Printing the same report below:');
  console.log('');
  return cmdTokens(opts);
}

function cmdParked(opts) {
  const { journalRoot } = resolveDirs(opts);
  const ids = listTaskDirs(journalRoot);
  let any = false;
  const abandonedRows = [];
  const reconciledRows = [];
  for (const id of ids) {
    const dir = path.join(journalRoot, id);
    const state = readJsonSafe(path.join(dir, 'state.json'), {});

    // action 5.1b: a PARKED or ABANDONED card whose ISSUE has since closed OUTSIDE the pipeline
    // (orchestrator/park-loop.js's reconcileExternalClosure, `state.externallyResolved`) is a
    // fact worth showing a maintainer, but a different one from "still waiting on a retry/abandon
    // reply" -- so it is pulled out of both the PARKED and the ABANDONED buckets below and
    // printed under its own heading instead. Measured 2026-09-01: 3 of 3 parked-or-abandoned
    // cards in the live corpus (issue-213, issue-428, issue-443) were exactly this shape -- two
    // closed by a human hours after the park, one (443) a false park whose own PR had actually
    // merged 30 seconds later -- so before this split `spo parked` read as 3 actionable items when
    // it was really 1 (issue-385, genuinely open and genuinely waiting). This `continue` has to
    // run BEFORE the `any`/abandonedRows branches below, or a reconciled row would double-count
    // into whichever one it started in.
    if ((state.state === 'PARKED' || state.state === 'ABANDONED') && state.externallyResolved) {
      const r = state.externallyResolved;
      const mergedPart = r.mergedAt ? `  mergedAt=${r.mergedAt}` : '';
      reconciledRows.push(
        `${id}  reason=${state.reason || 'unknown'}  title=${state.title || ''}  via=${r.via}  closedAt=${r.closedAt}${mergedPart}`
      );
      continue;
    }

    if (state.state === 'PARKED') {
      any = true;
      console.log(`${id}  reason=${state.reason || 'unknown'}  title=${state.title || ''}`);
    } else if (state.state === 'ABANDONED') {
      // action 4.5: an ABANDONED card used to be invisible here entirely -- `state.state ===
      // 'PARKED'` is the only filter this command ever had, so once unparkScan marked a card
      // ABANDONED it dropped off `spo parked` with no trace, even though it's the terminal
      // outcome of a park. Collected separately and printed under its own heading below rather
      // than folded into the PARKED rows above: the two ask different questions of a maintainer
      // ("what still needs a retry/abandon reply" vs. "what did I already close out"), and
      // `(no parked tasks)` below must keep meaning exactly what it always meant for the PARKED
      // section -- never silently start covering abandoned ones too.
      abandonedRows.push(`${id}  reason=${state.reason || 'unknown'}  title=${state.title || ''}`);
    }
  }
  if (!any) console.log('(no parked tasks)');
  if (abandonedRows.length) {
    console.log('abandoned:');
    for (const r of abandonedRows) console.log(r);
  }
  if (reconciledRows.length) {
    console.log('resolved externally (issue closed outside the pipeline -- see reason for the original park/abandon):');
    for (const r of reconciledRows) console.log(r);
  }
}

// `spo resume <session_id|task-id>` -- resolves the argument as a task id first (a directory
// under journal/); if that exists, lists every recorded LLM step (journal event
// {event: "llm-call", step, model, billableTokens, sessionId} -- see steps/llm.js) and prints
// the exact `claude --resume <sessionId>` command for each, oldest first. If no such task
// directory exists, the argument is treated as a bare session id and the same command is
// printed once. This only ever prints -- it never spawns `claude` itself.
function cmdResume(id, opts) {
  const { journalRoot } = resolveDirs(opts);
  const dir = path.join(journalRoot, id);

  if (fs.existsSync(dir) && fs.statSync(dir).isDirectory()) {
    const llmCalls = readJournalLines(dir).filter((e) => e.event === 'llm-call' && e.sessionId);
    if (llmCalls.length === 0) {
      console.log(`no recorded LLM steps with a session id for task "${id}"`);
      return;
    }
    for (const ev of llmCalls) {
      const billable = typeof ev.billableTokens === 'number' ? formatTokenCount(ev.billableTokens) : '?';
      console.log(`${String(ev.step).padEnd(18)} model=${ev.model || '?'}  billableTokens=${billable}  claude --resume ${ev.sessionId}`);
    }
    return;
  }

  // Not a known task id -- treat the argument itself as a session id.
  console.log(`claude --resume ${id}`);
}

// `spo dashboard` -- generates console/dashboard.html (or --out <path>) from the same local
// surfaces the other commands read, plus the account pool and ~/.spo-bench/ (nightly, gate
// verdicts). All fs work lives in console/collect.js; all HTML rendering lives in
// console/render.js as a pure function -- this is just the CLI glue between the two and disk.
function cmdDashboard(opts) {
  const { journalRoot, queueDir } = resolveDirs(opts);
  const repoRoot = path.join(__dirname, '..');
  const accountsDir = resolveAccountsDir(opts);
  const benchRoot = path.join(os.homedir(), '.spo-bench');
  const spoReportsDir = opts.reportsDir ? path.resolve(opts.reportsDir) : defaultConfig.spoReportsDir;
  const outPath = opts.out ? path.resolve(opts.out) : path.join(repoRoot, 'console', 'dashboard.html');
  const sources = { journalRoot, queueDir, accountsDir, benchRoot, spoReportsDir };

  // --serve: a live HTTP view -- CPU/memory polled every 1s, everything else every 30s, no
  // page reload (see console/serve.js). The local/LAN tier of the dashboard; the externally
  // hosted copy is nginx's job (SPO-Deploy). Default port 8090 -- never 8080, which belongs to
  // the bench worker. --no-prod disables the starpeace.zz.works probe (console/prod-version.js)
  // for an offline/dev run. --host binds to a specific interface (default: all).
  if (opts.serve) {
    const { createDashboardServer, discoverUsageRoots } = require('../console/serve');
    const { createSystemSampler } = require('../console/system');
    const { createProdProbe } = require('../console/prod-version');
    const { createUsageScanner } = require('../console/usage-scan');
    const port = opts.port ? Number(opts.port) : 8090;
    const server = createDashboardServer(sources, {
      systemSampler: createSystemSampler(),
      prodProbe: opts.noProd ? null : createProdProbe(),
      usageScanner: createUsageScanner({ roots: discoverUsageRoots(accountsDir) }),
    });
    server.listen(port, opts.host || undefined, () => {
      const addr = server.address();
      console.log(
        `dashboard: http://localhost:${addr.port}/  (api: /api/system 1s, /api/data 30s -- Ctrl-C to stop)`
      );
    });
    return;
  }

  function generateOnce() {
    const data = collectAll(sources);
    const html = renderDashboard(data);
    fs.mkdirSync(path.dirname(outPath), { recursive: true });
    fs.writeFileSync(outPath, html);
    console.log(outPath);
  }

  generateOnce();
  if (opts.watch) {
    setInterval(generateOnce, 30000);
  }
}

// `spo accounts` -- lists every account discovered in the pool directory (one subdirectory per
// account -- see orchestrator/accounts.js): name, enabled, cooldownUntil (only shown while
// actually cooling), whether an oauth-token file is present, and whether the account's
// CLAUDE_CONFIG_DIR holds any credentials file of its own (anything besides oauth-token/
// disabled). Same fields the dashboard's "Comptes Claude" section shows.
function cmdAccounts(opts) {
  const accountsDir = resolveAccountsDir(opts);
  const registry = accounts.readRegistry(accountsDir);
  if (registry.length === 0) {
    console.log(`(no accounts registered in ${accountsDir} -- see doc/setup.md § Accounts)`);
    return;
  }

  const state = accounts.readState(accountsDir);
  const now = Date.now();
  for (const a of registry) {
    const entry = state[a.name];
    const cooldownUntil = entry && typeof entry.cooldownUntil === 'number' ? entry.cooldownUntil : null;
    const cooling = typeof cooldownUntil === 'number' && cooldownUntil > now;
    const token = a.oauthTokenFile ? 'yes' : 'no';
    const credentials = accounts.hasCredentials(a.configDir) ? 'yes' : 'no';
    console.log(
      `${a.name}  enabled=${a.enabled}  cooldownUntil=${cooling ? new Date(cooldownUntil).toISOString() : '-'}  token=${token}  credentials=${credentials}`
    );
  }
}

// `spo account add <name>` -- creates <accounts-dir>/<name>/ and PRINTS the guided next steps.
// Never runs `claude` itself (see CLAUDE.md-style "never probe/never spawn" discipline this
// whole CLI follows -- bin/spo only ever reads and, here, creates a directory).
function cmdAccountAdd(name, opts) {
  if (!name) {
    console.error('usage: spo account add <name>');
    process.exitCode = 1;
    return;
  }
  const accountsDir = resolveAccountsDir(opts);
  const dir = path.join(accountsDir, name);
  fs.mkdirSync(dir, { recursive: true });
  const tokenFile = path.join(dir, accounts.OAUTH_TOKEN_FILENAME);

  console.log(`Created ${dir}`);
  console.log('');
  console.log('Next steps:');
  console.log(`  1. CLAUDE_CONFIG_DIR=${dir} claude setup-token`);
  console.log(`  2. paste the printed token into ${tokenFile}`);
  console.log(`  3. chmod 600 ${tokenFile}`);
  // Complete, copy-pasteable command (maintainer rule: never a bare subcommand).
  console.log(`  4. ${path.join(__dirname, 'spo')} accounts   # verify it shows up, enabled, token=yes`);

  // The new account starts with no user-tier permission rules at all (its directory IS its
  // CLAUDE_CONFIG_DIR). Sync immediately so it never runs a step under a different policy than
  // its siblings -- the daemon syncs too, but only at --real startup, which may be much later.
  const synced = accounts.syncSettings(accountsDir, readPipelineSettingsText());
  const mine = synced.find((r) => r.name === name);
  if (mine) console.log(`\nPermission policy ${mine.action}: ${mine.path}`);
}

// The repo's own .claude/settings.json is the single source of truth for the pool's user-tier
// policy -- reviewed in git, applied verbatim to every account. Read here rather than kept as a
// second copy inside the CLI, so the two can never drift.
function readPipelineSettingsText() {
  const source = path.join(__dirname, '..', '.claude', 'settings.json');
  return accounts.stampManagedSettings(fs.readFileSync(source, 'utf8'), '<repo>/.claude/settings.json');
}

// `spo account sync-settings [--dry]` -- installs that policy as every pool account's user-tier
// settings.json. Idempotent: an account already carrying the current policy reports `unchanged`
// and is not rewritten. --dry reports what would change and writes nothing.
function cmdAccountSyncSettings(opts) {
  const accountsDir = resolveAccountsDir(opts);
  let settingsText;
  try {
    settingsText = readPipelineSettingsText();
  } catch (err) {
    console.error(`spo account sync-settings: cannot read the source policy -- ${err.message}`);
    process.exitCode = 1;
    return;
  }

  const results = accounts.syncSettings(accountsDir, settingsText, { dryRun: opts.dry });
  if (results.length === 0) {
    console.log(`(no accounts registered in ${accountsDir} -- see doc/setup.md § Accounts)`);
    return;
  }
  for (const r of results) {
    console.log(`${r.action.padEnd(9)} ${r.name}  ${r.path}`);
  }
  if (opts.dry) console.log('\n--dry: nothing written.');
}

function accountMarkerDir(accountsDir, name, subcommand) {
  if (!name) {
    console.error(`usage: spo account ${subcommand} <name>`);
    process.exitCode = 1;
    return null;
  }
  const dir = path.join(accountsDir, name);
  if (!fs.existsSync(dir)) {
    console.error(`spo account ${subcommand}: no account "${name}" in ${accountsDir} (see \`spo accounts\`)`);
    process.exitCode = 1;
    return null;
  }
  return dir;
}

// `spo account enable/disable <name>` -- create or remove the `disabled` marker file. The
// marker's mere presence disables the account (accounts.js's readRegistry); content is never
// read, so an empty file is enough.
function cmdAccountEnable(name, opts) {
  const accountsDir = resolveAccountsDir(opts);
  const dir = accountMarkerDir(accountsDir, name, 'enable');
  if (!dir) return;
  const marker = path.join(dir, accounts.DISABLED_MARKER_FILENAME);
  if (fs.existsSync(marker)) fs.rmSync(marker);
  console.log(`${name}: enabled`);
}

function cmdAccountDisable(name, opts) {
  const accountsDir = resolveAccountsDir(opts);
  const dir = accountMarkerDir(accountsDir, name, 'disable');
  if (!dir) return;
  fs.writeFileSync(path.join(dir, accounts.DISABLED_MARKER_FILENAME), '');
  console.log(`${name}: disabled`);
}

// `spo ask <text…>` -- intake, fast lane: DRAFT_CARD (Sonnet 5) -> review-card (Fable 5) -> file
// on FILE/FILE_AMENDED, or print the reason and file nothing on DO_NOT_FILE. `--draft-file
// <path>` is the brainstorm lane instead: an interactive session has already formalized its own
// draft JSON, so this skips the DRAFT_CARD LLM call entirely (see orchestrator/intake.js's
// loadDraftFile) and goes straight to review -> file. `--dry` (either lane) prints the draft +
// verdict and files nothing. Exit 0 for every JUDGED outcome (FILE/FILE_AMENDED/DO_NOT_FILE);
// non-zero only for a mechanical failure (no account, a bad LLM reply, a malformed --draft-file,
// a failed gh call).
//
// `spo ask`/`spo pull` have no daemon.jsonl of their own to journal into (unlike auto-triage.js's
// `report-triage-retry` event for triageBugReport's own retry) -- this IS the daemon.jsonl
// equivalent for an interactive session: a stderr line, printed whenever draftCard/reviewCard
// retried after a deadline timeout, so the maintainer sees the step ran twice instead of it
// silently costing double.
function logRetryIfAny(stepName, result) {
  if (result && result.retriedAfterTimeout) {
    const r = result.retriedAfterTimeout;
    console.error(`${stepName}: retried after a ${r.deadlineMs}ms deadline timeout (retryOk=${r.retryOk})`);
  }
}

// `deps.intake` is a test-only override (default: the real orchestrator/intake.js module) --
// same injection convention as everywhere else in this repo, applied at this one extra layer so
// the test suite can drive the real CLI wiring (parseArgs -> cmdAsk's own dry/DO_NOT_FILE/filing
// branches) against a fake intake module instead of a real `claude`/`gh` spawn.
async function cmdAsk(opts, deps = {}) {
  const intakeImpl = deps.intake || intake;
  let draft;

  if (opts.draftFile) {
    const loaded = intakeImpl.loadDraftFile(opts.draftFile);
    if (!loaded.ok) {
      console.error(loaded.error);
      process.exitCode = 1;
      return;
    }
    draft = loaded.draft;
  } else {
    const requestText = opts._.join(' ').trim();
    if (!requestText) {
      console.error('usage: spo ask <text…> | spo ask --draft-file <path>  [--dry]');
      process.exitCode = 1;
      return;
    }
    const drafted = await intakeImpl.draftCard(requestText, {});
    logRetryIfAny('draftCard', drafted);
    if (!drafted.ok) {
      console.error(drafted.error);
      process.exitCode = 1;
      return;
    }
    draft = drafted.draft;
  }

  const reviewed = await intakeImpl.reviewCard(draft, {});
  logRetryIfAny('reviewCard', reviewed);
  if (!reviewed.ok) {
    console.error(reviewed.error);
    process.exitCode = 1;
    return;
  }
  const review = reviewed.review;

  if (opts.dry) {
    console.log('--- draft ---');
    console.log(JSON.stringify(draft, null, 2));
    console.log('--- review ---');
    console.log(JSON.stringify(review, null, 2));
    return;
  }

  if (review.verdict === 'DO_NOT_FILE') {
    console.log('DO_NOT_FILE');
    console.log(review.first_comment_markdown);
    return;
  }

  const filed = intakeImpl.fileCard(draft, review, {});
  if (!filed.ok) {
    console.error(filed.error);
    process.exitCode = 1;
    return;
  }
  console.log(`${review.verdict}: filed #${filed.issueNumber}`);
  console.log(filed.url);
}

// `spo pull [--limit N]` -- reads the product board's cheap pool read (npm run board:claim,
// never a claim, never a board write) and writes a local queue/<seq>-issue-<n>.json for each of
// the top N claimable candidates (default 5), skipping one already queued or journaled. Never
// runs `daemon.js` itself -- `spo pull` only ever populates queue/. `deps.intake`: see cmdAsk.
async function cmdPull(opts, deps = {}) {
  const intakeImpl = deps.intake || intake;
  const limit = opts.limit ? Number(opts.limit) : 5;
  const pulled = intakeImpl.pullBoard({});
  if (!pulled.ok) {
    console.error(pulled.error);
    process.exitCode = 1;
    return;
  }
  for (const warning of pulled.warnings) console.error(warning);

  const top = pulled.candidates.slice(0, limit);
  if (top.length === 0) {
    console.log('(no claimable candidates)');
    return;
  }

  for (const candidate of top) {
    const made = intakeImpl.makeTask(candidate, {});
    if (!made.ok) {
      console.error(`#${candidate.issue}: ${made.error}`);
      process.exitCode = 1;
      continue;
    }
    if (made.skipped) {
      console.log(`#${candidate.issue}: skipped -- ${made.reason}`);
    } else {
      console.log(`#${candidate.issue}: wrote queue/${made.file}`);
    }
  }
}

// `spo pull-reports` -- stage 0 of the human-first bug-report pipeline: pulls queued reports
// from a production deployment's own bug-report store over HTTPS
// (orchestrator/remote-report-pull.js's runRemoteReportPull) into the local queue, where `spo
// intake` picks them up exactly as a locally-captured report. Requires config.remoteReportUrl
// (SPO_REMOTE_REPORT_URL) and a readable token file (default ~/.spo-reports/.pull-token,
// SPO_REPORT_PULL_TOKEN_FILE) -- prints a clear "not configured" message and exits 0 (nothing to
// do, not a failure) when either is missing. `deps.remoteReportPull`: same test-only override
// convention as `deps.intake`.
async function cmdPullReports(opts, deps = {}) {
  const impl = deps.remoteReportPull || remoteReportPull;
  const { journalRoot } = resolveDirs(opts);

  const result = await impl.runRemoteReportPull(journalRoot, defaultConfig, {});

  if (!result.ok) {
    console.error(result.error);
    process.exitCode = 1;
    return;
  }
  if (result.skipped === 'no-url') {
    console.log('(SPO_REMOTE_REPORT_URL is not set -- nothing to pull)');
    return;
  }
  if (result.skipped === 'no-token') {
    console.log(`(no pull token readable at ${defaultConfig.remoteReportTokenFile} -- nothing to pull)`);
    return;
  }
  if (result.skipped === 'queue-ceiling') {
    console.log('(local report queue is already at its ceiling -- skipped this cycle)');
    return;
  }

  console.log(`listed: ${result.listed}  pulled: ${result.pulled}  acked: ${result.acked}  rejected: ${result.rejected}  errors: ${result.errors.length}`);
  for (const e of result.errors) console.error(`${e.file}: ${e.error}`);
  if (result.errors.length > 0) process.exitCode = 1;
}

// `spo intake [--limit N] [--reports-dir <dir>]` -- stage 1 of the human-first bug-report
// pipeline: mechanically files a RAW card per queued report (zero LLM calls) via
// orchestrator/report-intake.js's runReportIntake and waits for a maintainer's "confirm"/
// "discard" reply on the issue. Never runs `daemon.js`. `deps.reportIntake`: same test-only
// override convention as `deps.intake` (cmdAsk/cmdPull).
async function cmdIntake(opts, deps = {}) {
  const reportIntakeImpl = deps.reportIntake || reportIntake;
  const { journalRoot } = resolveDirs(opts);
  const reportsDir = opts.reportsDir || defaultConfig.spoReportsDir;
  const limit = opts.limit ? Number(opts.limit) : reportIntakeImpl.DEFAULT_AUTO_INTAKE_LIMIT;

  const result = await reportIntakeImpl.runReportIntake(journalRoot, { ...defaultConfig, spoReportsDir: reportsDir, autoIntakeLimit: limit }, {});

  if (result.processed === 0) {
    console.log(`(no queued reports in ${reportsDir})`);
    return;
  }
  for (const r of result.results) {
    if (r.outcome === 'filed') console.log(`${r.file}: filed #${r.issueNumber} (${defaultConfig.reportIntakeColumn}) -- reply "confirm"/"discard" on the issue`);
    else if (r.outcome === 'duplicate') console.log(`${r.file}: duplicate of #${r.issueNumber}`);
    else if (r.outcome === 'schema-version') console.log(`${r.file}: schema version mismatch (found ${r.found}, expected ${r.expected}) -- left in queue`);
    else console.log(`${r.file}: error -- ${r.error}`);
  }
  console.log('');
  console.log(`processed: ${result.processed}  filed: ${result.filed}  duplicates: ${result.duplicates}  schema-version: ${result.schemaVersion}  errors: ${result.errors.length}`);
  if (result.errors.length > 0) process.exitCode = 1;
}

// `spo reports [--reports-dir <dir>]` -- lists what is waiting in <reports-dir>/pending/ (raw
// cards already filed, awaiting a "confirm"/"discard" reply) -- the intake analogue of
// `spo parked`. Reads only the filesystem, no `gh` call.
function cmdReports(opts) {
  const reportsDir = opts.reportsDir || defaultConfig.spoReportsDir;
  const pendingDir = path.join(reportsDir, 'pending');
  if (!fs.existsSync(pendingDir)) {
    console.log(`(no pending directory at ${pendingDir})`);
    return;
  }
  const files = fs.readdirSync(pendingDir).filter((f) => f.endsWith('.json'));
  if (files.length === 0) {
    console.log('(nothing pending)');
    return;
  }
  for (const f of files.sort()) {
    const stat = fs.statSync(path.join(pendingDir, f));
    const ageMin = Math.round((Date.now() - stat.mtimeMs) / 60000);
    console.log(`${f}  waiting ${ageMin}min`);
  }
}

// `spo triage [--limit N] [--file]` -- stage 3+ of the human-first bug-report pipeline:
// reproduces/routes/drafts every report a maintainer has already replied "confirm" to (via `spo
// reports`/the issue comments -- see orchestrator/report-intake.js) through
// orchestrator/auto-triage.js's runAutoTriage (triageBugReport, then the same reviewCard gate
// `spo ask`/`spo pull` use, then intake.amendCard -- edits the raw card in place). Never runs
// `daemon.js`. Defaults to --dry. `deps.autoTriage`: same test-only override convention as
// `deps.intake` (cmdAsk/cmdPull).
//
// `--retry <issue>` (action 3.4) switches to a different mode entirely -- see cmdTriageRetry
// below and orchestrator/auto-triage.js's retryHeldReport for the mechanism. Checked first: a
// `--retry` and a normal triage cycle are mutually exclusive, and `--limit` has no meaning for a
// single-issue recovery.
async function cmdTriage(opts, deps = {}) {
  const autoTriageImpl = deps.autoTriage || autoTriage;
  const { journalRoot } = resolveDirs(opts);

  // opts.retry defaults to `null` (parseArgs) and stays there unless `--retry` was seen at all --
  // including `--retry` as the LAST argv token, where `argv[++i]` reads past the end and yields
  // `undefined`, NOT `null`. So the check is `!== null`, deliberately not also excluding
  // `undefined`: that "flag present, value missing" shape must still route into cmdTriageRetry,
  // whose own `if (!raw)` guard is what turns it into the legible "usage: ..." refusal -- routing
  // it into a normal triage cycle instead would silently ignore a maintainer's typo.
  if (opts.retry !== null) {
    return cmdTriageRetry(opts, autoTriageImpl, journalRoot);
  }

  const limit = opts.limit ? Number(opts.limit) : autoTriageImpl.DEFAULT_AUTO_TRIAGE_LIMIT;
  const dry = !opts.file;

  const result = await autoTriageImpl.runAutoTriage(journalRoot, { ...defaultConfig, autoTriageLimit: limit }, {}, { dry });

  if (!result.ok) {
    console.error(result.error);
    process.exitCode = 1;
    return;
  }

  if (result.processed === 0) {
    console.log('(no confirmed reports awaiting triage -- see `spo reports`)');
    return;
  }

  for (const r of result.results) {
    if (r.outcome === 'filed') console.log(`#${r.issue}: filed -- ${r.url}`);
    else if (r.outcome === 'would-file') console.log(`#${r.issue}: would file -- ${r.draft.title}`);
    else if (r.outcome === 'duplicate' || r.outcome === 'would-duplicate') console.log(`#${r.issue}: duplicate of #${r.issueNumber}`);
    else if (r.outcome === 'error') console.log(`#${r.issue}: error -- ${r.error}`);
    else if (r.outcome === 'already-claimed') console.log(`#${r.issue}: already claimed by another runner -- skipped`);
    else console.log(`#${r.issue}: held (${r.outcome}) -- ${r.reason || ''}`);
  }

  console.log('');
  console.log(`processed: ${result.processed}  filed: ${result.filed}  duplicates: ${result.duplicates}  held: ${result.held}  already-claimed: ${result.alreadyClaimed || 0}  errors: ${result.errors.length}`);
  if (dry) console.log('(dry run -- nothing filed, nothing archived, nothing commented; pass --file to act)');

  if (result.errors.length > 0) process.exitCode = 1;
}

// `spo triage --retry <issue> [--file]` -- action 3.4: the recovery path for a report stuck at
// HOLD (report-held / report-held-mechanical / report-held with outcome do-not-file). See
// orchestrator/auto-triage.js's retryHeldReport for the mechanism itself, its three refusals, and
// why a single fresh report-confirmed event both re-opens the report and resets the mechanical-
// failure budget in the same move.
//
// Accepts a `#`-prefixed issue (`--retry #449` is what a maintainer will actually paste from a
// GitHub thread) and rejects anything else -- a missing value, a non-numeric one -- with a legible
// message and a non-zero exit (CLAUDE.md: verdict by exit code, never by reading text).
//
// Like every other `spo triage` invocation this defaults to --dry -- a maintainer who runs the
// bare `--retry <issue>` first (the convention this whole CLI already follows) gets a safe
// preview that appends and comments nothing; `--file` is required to actually act. `result.error`
// from retryHeldReport (an unmet precondition) is printed and exits non-zero without ever calling
// runAutoTriage.
async function cmdTriageRetry(opts, autoTriageImpl, journalRoot) {
  const raw = opts.retry;
  if (!raw) {
    console.error('usage: spo triage --retry <issue> [--file]');
    process.exitCode = 1;
    return;
  }
  const issueStr = raw.startsWith('#') ? raw.slice(1) : raw;
  if (!/^\d+$/.test(issueStr)) {
    console.error(`spo triage --retry: "${raw}" is not a valid issue number (expected e.g. 449 or #449)`);
    process.exitCode = 1;
    return;
  }
  const issue = Number(issueStr);
  const dry = !opts.file;

  const result = await autoTriageImpl.retryHeldReport(journalRoot, issue, defaultConfig, {}, { dry });

  if (!result.ok) {
    console.error(`#${issue}: ${result.error}`);
    process.exitCode = 1;
    return;
  }

  if (dry) {
    console.log(`#${issue}: would re-inject (currently ${result.retriedFrom}) -- dry run, nothing appended or commented; pass --file to actually act`);
    return;
  }

  console.log(`#${issue}: re-injected (was ${result.retriedFrom}) -- eligible for triage again, mechanical-failure count reset to 0`);
  console.log(`  comment posted: ${result.commentPosted ? 'yes' : `no (${result.commentError || 'unknown error'})`}`);
}

// `spo recette [--scenario <name>] [--keep] [--dry] [--force]` -- ACTION 2.9, see this file's
// own usage header and orchestrator/recette.js for the full design. Exit code IS the verdict
// (CLAUDE.md: "Verdict by exit code, never by reading text output") -- 0 only when the run
// actually completed AND every one of the scenario's declared assertions passed; a refusal
// (daemon lock held), a tripped cap, a park, or a failed assertion are all exit 1. `deps.recette`
// is the test-only override (same convention as `deps.intake`/`deps.autoTriage`).
async function cmdRecette(opts, deps = {}) {
  const impl = deps.recette || recette;
  const result = await impl.runRecette(
    {
      scenario: opts.scenario,
      keep: opts.keep,
      dry: opts.dry,
      force: opts.force,
      recetteDir: opts.recetteDir,
      accountsDir: opts.accountsDir,
      capMs: opts.capMs || null,
      capLlmSteps: opts.capLlmSteps || null,
    },
    {}
  );

  if (result.dry) {
    console.log(`spo recette --dry -- scenario "${result.scenario}" (nothing runs):`);
    for (const line of result.plan.steps) console.log(`  - ${line}`);
    console.log('');
    console.log(`  journal root:          ${result.plan.journalRoot}`);
    console.log(`  queue dir:             ${result.plan.queueDir}`);
    console.log(`  product journal (lock check): ${result.plan.productJournalRoot}`);
    console.log(`  cap:                   ${result.plan.capMs}ms wall clock / ${result.plan.capLlmSteps} LLM steps`);
    return;
  }

  if (result.refused) {
    console.error(`spo recette: refused (${result.reason}) -- ${JSON.stringify(result.detail)}`);
    process.exitCode = 1;
    return;
  }

  console.log(`spo recette: scenario "${result.scenario}", run ${result.runId}`);
  if (result.issueNumber) console.log(`  issue:      #${result.issueNumber}  ${result.issueUrl || ''}`);
  console.log(`  finalState: ${result.finalState}`);
  console.log(`  elapsed:    ${result.elapsedMs}ms  llmSteps: ${result.llmSteps}`);
  if (result.capTripped) console.log(`  CAP TRIPPED: ${result.capTripped.reason} -- ${JSON.stringify(result.capTripped)}`);
  if (result.error) console.error(`  error: ${result.error.name}: ${result.error.message}`);

  if (result.assertions) {
    for (const a of result.assertions.results) {
      console.log(`  [${a.ok ? 'ok' : 'FAIL'}] ${a.id} -- ${a.description}${a.ok ? '' : ` (${a.detail})`}`);
    }
  } else {
    console.log('  (no assertions evaluated -- the run did not reach a finalState)');
  }

  if (result.cleanupReport) {
    // Only genuinely unaccounted-for steps are reported. A step whose artifact was ALREADY gone
    // is clean -- on the success path FINISH removed the worktree, MERGE merged the PR and the
    // merge deleted the remote branch, so three steps exit non-zero on a perfect run. Printing
    // those as failures taught the reader to ignore the one line that reports a real leak.
    const steps = result.cleanupReport.steps;
    const failed = steps.filter((s) => !s.ok);
    const gone = steps.filter((s) => s.gone);
    const goneNote = gone.length ? `, ${gone.length} already gone` : '';
    console.log(
      failed.length
        ? `  cleanup: ${steps.length} step(s)${goneNote}, ${failed.length} NOT CLEAN` +
            ` (${failed.map((s) => s.name).join(', ')} -- state may have been left behind)`
        : `  cleanup: ${steps.length} step(s)${goneNote}, nothing left behind`
    );
  } else if (result.kept) {
    console.log(`  --keep: cleanup skipped -- inspect ${result.plan.runDir}`);
  }

  process.exitCode = result.ok ? 0 : 1;
}

function printUsage() {
  console.error(
    [
      'usage: spo <status|task <id>|parked|tokens|cost|resume <session_id|task-id>|dashboard|accounts|account <add|enable|disable> <name>|account sync-settings|ask <text…>|pull|pull-reports|intake|reports|triage|recette>',
      '            [--journal <dir>] [--queue <dir>] [--out <path>] [--watch] [--serve [--port <n>]] [--accounts-dir <dir>]',
      '            ask: [--dry] [--draft-file <path>]   pull: [--limit <n>]',
      '            intake: [--limit <n>] [--reports-dir <dir>]   reports: [--reports-dir <dir>]',
      '            triage: [--limit <n>] [--file]   (defaults to --dry)   OR   triage --retry <issue> [--file]',
      '            recette: [--scenario <name>] [--keep] [--dry] [--force] [--recette-dir <dir>] [--cap-ms <n>] [--cap-llm-steps <n>]',
    ].join('\n')
  );
}

function main() {
  const [cmd, ...rest] = process.argv.slice(2);
  const opts = parseArgs(rest);

  if (cmd === 'status') return cmdStatus(opts);
  if (cmd === 'task') {
    const id = opts._[0];
    if (!id) {
      console.error('usage: spo task <id>');
      process.exitCode = 1;
      return;
    }
    return cmdTask(id, opts);
  }
  if (cmd === 'parked') return cmdParked(opts);
  if (cmd === 'tokens') return cmdTokens(opts);
  if (cmd === 'cost') return cmdCostDeprecated(opts);
  if (cmd === 'resume') {
    const id = opts._[0];
    if (!id) {
      console.error('usage: spo resume <session_id|task-id>');
      process.exitCode = 1;
      return;
    }
    return cmdResume(id, opts);
  }
  if (cmd === 'dashboard') return cmdDashboard(opts);
  if (cmd === 'accounts') return cmdAccounts(opts);
  if (cmd === 'account') {
    const sub = opts._[0];
    const name = opts._[1];
    if (sub === 'add') return cmdAccountAdd(name, opts);
    if (sub === 'enable') return cmdAccountEnable(name, opts);
    if (sub === 'disable') return cmdAccountDisable(name, opts);
    if (sub === 'sync-settings') return cmdAccountSyncSettings(opts);
    console.error('usage: spo account <add|enable|disable> <name> | spo account sync-settings [--dry]');
    process.exitCode = 1;
    return;
  }
  if (cmd === 'ask') return cmdAsk(opts);
  if (cmd === 'pull') return cmdPull(opts);
  if (cmd === 'pull-reports') return cmdPullReports(opts);
  if (cmd === 'intake') return cmdIntake(opts);
  if (cmd === 'reports') return cmdReports(opts);
  if (cmd === 'triage') return cmdTriage(opts);
  if (cmd === 'recette') return cmdRecette(opts);

  printUsage();
  process.exitCode = 1;
}

// cmdAsk/cmdPull are async (they await orchestrator/intake.js's LLM/spawn calls); every other
// command is synchronous and main() just returns undefined for them. Awaiting unconditionally
// here would be a no-op for the sync commands (Promise.resolve(undefined) still resolves this
// tick) but it is skipped anyway so a thrown synchronous error (e.g. `spo task` with no
// journal) keeps its original, un-wrapped stack rather than becoming an unhandled rejection.
function run() {
  const result = main();
  if (result && typeof result.then === 'function') {
    result.catch((err) => {
      console.error(`spo: ${err && err.message ? err.message : err}`);
      process.exitCode = 1;
    });
  }
}

// Only actually run when invoked as the CLI (`node bin/spo ...`, including every existing
// execFileSync-based test) -- `require.main === module` is false when the test suite instead
// `require()`s this file to reach parseArgs/cmdAsk/cmdPull directly with an injected fake
// `intake` module (see cmdAsk's `deps.intake`), so requiring it for that never spawns anything
// or touches this process's own argv/exit code.
if (require.main === module) {
  run();
}

module.exports = { parseArgs, cmdAsk, cmdPull, cmdPullReports, cmdIntake, cmdReports, cmdTriage, cmdRecette, main };
